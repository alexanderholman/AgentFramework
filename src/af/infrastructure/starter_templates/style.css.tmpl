:root {font-family: system-ui, sans-serif; color: #163025; background: #f4f6f2; color-scheme: light;}
body {margin: 0;} main {max-width: 48rem; margin: 5rem auto; padding: 2rem; background: white; border: 1px solid #d7dfd5; border-radius: 1rem;}
h1 {font-size: 3rem; letter-spacing: -.04em; margin: .5rem 0;} .eyebrow {font-size: .8rem; letter-spacing: .15em; color: #42624c;}
label, textarea {display: block;} textarea {box-sizing: border-box; width: 100%; min-height: 7rem; margin: .6rem 0; padding: .8rem; font: inherit; border: 1px solid #788779; border-radius: .35rem;}
button {background: #163f2e; color: white; border: 0; border-radius: .35rem; padding: .7rem 1.2rem; font: inherit; cursor: pointer;} button:disabled {opacity: .6;}
a {color: #175b3c;} nav {display: flex; gap: 1.5rem; margin-top: 2rem;} pre {white-space: pre-wrap; overflow-wrap: anywhere;}
@media (max-width: 52rem) {main {margin: 1rem; padding: 1.2rem;} h1 {font-size: 2.2rem;}}
